# Required: your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: a server (guild) ID to sync slash commands to instantly while testing.
# Leave blank to register commands globally (can take up to an hour to appear).
DISCORD_DEV_GUILD_ID=

# Where the SQLite database lives (inside the container, /data is a mounted volume).
FANTASYMTG_DB_PATH=/data/fantasymtg.db

# How often (seconds) to run scheduled jobs: trade timeouts, top-offs, leaderboards, game end.
FANTASYMTG_TICK_SECONDS=60

LOG_LEVEL=INFO
